# Copy to .env.dev (gitignored) and fill in. Used by scripts/dev/*.

# ─── Laptop reachability ──────────────────────────────────────────────
# Space-separated IPv4 prefixes; start-dev-stack.sh picks the first matching
# local interface IP. Cover both LAN-at-home and VPN subnets.
LAPTOP_SUBNETS="192.168.1. 10.8.0."

# ─── NPM API (for dev upstream flips) ─────────────────────────────────
NPM_BASE_URL=https://npm.example.com
NPM_API_USER=healthbridge-dev
NPM_API_PASSWORD=
# Proxy-host IDs in NPM for each hostname (see deploy/NPM.md).
NPM_HEALTHBRIDGE_PROXY_ID=
NPM_MCP_PROXY_ID=
# The normal (prod) forward target NPM points at when NOT flipped: the LAN IP of
# the Docker host running the HealthBridge containers. The flip swaps this to your
# laptop's IP and back. Used as a sanity check / fallback if no rollback file.
PROD_FORWARD_HOST=192.168.1.50
# Where the full-state rollback is stored on the NPM host.
NPM_ROLLBACK_PATH=/var/lib/healthbridge-dev/rollback.json
# If NPM runs in a Docker container, set its name so remote cmds wrap in docker exec.
# Leave blank if NPM is installed directly on the host.
NPM_DOCKER_CONTAINER=
# SSH target for the remote watchdog (e.g. user@192.168.1.10 or user@npm-host).
# If set, schedule-watchdog uploads rollback + watchdog.sh and schedules an `at` job
# on the NPM host so NPM reverts even if the laptop crashes. Leave blank to use
# only the local background watchdog (catches accidents, not crashes).
NPM_WATCHDOG_SSH=

# ─── App ──────────────────────────────────────────────────────────────
# Bearer token (same value the phone uses) so local runs accept the app's requests.
HEALTHBRIDGE_TOKEN=
# Apple Watch sleep source to keep on /ingest/hae (Health Auto Export sends both
# Apple Watch and SleepWatch). NBSP-insensitive — a normal space is fine. Quote it
# (shell-sourced). Empty = keep all sources (not recommended). See docs/HAE_SETUP.md.
HEALTHBRIDGE_SLEEP_SOURCE='Apple Watch van Owner'
# DuckDB path for local runs (kept out of /data; uses repo-local dev db).
HEALTHBRIDGE_DB=./dev.duckdb
# Banner label; start-dev-stack.sh overrides to "dev hosted from <hostname>".
APP_ENV=dev
