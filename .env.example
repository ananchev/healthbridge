# Copy to deploy/.env and fill in. NEVER commit the real .env.

# Bearer token the phone sends and the backend validates. Generate a long random
# value, e.g.:  openssl rand -hex 32
HEALTHBRIDGE_TOKEN=

# DuckDB path inside the containers (matches the mounted volume).
HEALTHBRIDGE_DB=/data/health.duckdb

# Environment label. "prod" hides the /stats banner; anything else shows it.
APP_ENV=prod

# Host ports to publish the containers on (NPM on its separate LAN box forwards
# to <docker-host-LAN-IP>:<port>). Defaults 8000/8001.
BACKEND_PORT=8000
MCP_PORT=8001

# Local dev only — set to 1 to bypass bearer auth on localhost. NEVER in prod.
# HEALTHBRIDGE_DEV=1
