# Copy to deploy/.env and fill in. NEVER commit the real .env.

# Bearer token the phone sends and the backend validates. Generate a long random
# value, e.g.:  openssl rand -hex 32
HEALTHBRIDGE_TOKEN=

# DuckDB path inside the containers (matches the mounted volume).
HEALTHBRIDGE_DB=/data/health.duckdb

# Environment label. "prod" hides the /stats banner; anything else shows it.
APP_ENV=prod

# Apple Watch sleep source kept on /ingest/hae (Health Auto Export sends both Apple
# Watch and SleepWatch). NBSP-insensitive — a normal space is fine. Empty = keep all
# sources (not recommended). See docs/HAE_SETUP.md.
HEALTHBRIDGE_SLEEP_SOURCE=Apple Watch

# Host ports to publish the containers on (NPM on its separate LAN box forwards
# to <docker-host-LAN-IP>:<port>). Defaults 8000/8001.
BACKEND_PORT=8000
MCP_PORT=8001

# Local dev only — set to 1 to bypass bearer auth on localhost. NEVER in prod.
# HEALTHBRIDGE_DEV=1

# LAN-only monitoring dashboard (/dashboard). It is unauthenticated and FAILS CLOSED:
# served only to direct LAN requests; anything arriving via the proxy (i.e. the public
# internet) gets 404. Leave this UNSET to keep it LAN-only. Set to 1 ONLY if you
# deliberately expose it publicly behind your OWN auth (NPM Access List / basic-auth).
# See deploy/NPM.md.
# HEALTHBRIDGE_DASHBOARD_PUBLIC=1

# ─── sleep-mcp (Resource Server) — see docs/MCP_AUTH.md ───────────────────────
# HS256 signing key SHARED with the mcp-auth Authorization Server (same value).
MCP_OAUTH_SIGNING_KEY=
# AS issuer and this RS's public origin (both single-label hosts under example.com).
MCP_AUTH_SERVER_URL=https://mcp-auth.example.com
MCP_PUBLIC_URL=https://mcp-healthbridge.example.com
